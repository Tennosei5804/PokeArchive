# Copie ce fichier en .env et remplis-le.
# .env ne doit JAMAIS être partagé ni versionné : c'est lui qui détient le mot
# de passe MySQL. C'est précisément pour qu'il ne quitte pas le serveur que
# cette API existe — l'application, elle, n'a que des jetons de session.

# Adresse publique de l'API. Elle construit l'adresse de retour Discord, donc
# en ligne ce sera https://api.ton-domaine.fr
API_URL=http://127.0.0.1:8787
PORT=8787
# 127.0.0.1 en local ; un hébergeur demandera 0.0.0.0
HOTE=127.0.0.1

# MySQL
DB_HOTE=
DB_PORT=3306
DB_UTILISATEUR=
DB_MOTDEPASSE=
DB_NOM=
# Chiffrer la liaison avec la base : « oui » chez un hébergeur, vide en local.
# La plupart refusent une connexion en clair, et ils ont raison — les
# identifiants et les Pokédex traverseraient le réseau à découvert.
DB_SSL=

# https://discord.com/developers/applications → OAuth2
# Déclare l'adresse de retour AU CARACTÈRE PRÈS dans OAuth2 > Redirects :
#   http://127.0.0.1:8787/auth/discord/retour     en local
#   https://api.ton-domaine.fr/auth/discord/retour en ligne
DISCORD_CLIENT_ID=
DISCORD_SECRET=

# Ton identifiant Discord, pour les routes d'administration (renommer un
# dresseur dont le pseudo ne peut pas rester). Vide, elles repondent 404 :
# personne n'est administrateur tant que personne n'est nomme.
# Discord > Parametres > Avance > Mode developpeur, puis clic droit sur soi.
ADMIN_DISCORD_ID=
